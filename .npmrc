# Ignore peerDependencies during install.
#
# Expo Router (and friends) declare unbounded peers like `react: "*"` and
# `react-native-gesture-handler: "*"`. npm auto-installs the latest matching
# version at the workspace root, which conflicts with the exact versions the
# mobile app pins, so every native module ends up duplicated (one at the root,
# one nested in apps/app). Ignoring peers lets the app's pinned versions hoist
# cleanly, so expo-doctor sees a single copy of each native module.
legacy-peer-deps=true
